// 中转利润管理中台 —— 数据模型
//
// SQLite 下 Prisma 不支持 enum, 所有"枚举"一律用 String + 注释列出合法值,
// 由 src/lib/rbac.ts 与各 handler 的常量数组在 API 层校验。
//
// 日期字段的两种写法是刻意区分的:
//   DateTime —— 记录"发生时刻"(createdAt / handledAt / expiresAt)
//   String   —— 记录"业务日历日", 存 "YYYY-MM-DD"。业务口径是 Asia/Shanghai
//                的自然日, 用 DateTime 会在跨时区读写时偏移一天。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════
// 账号与权限
// ═══════════════════════════════════════════════════════════════════

/// 系统用户。单角色模型 —— 一人一岗, admin 隐式拥有全部权限。
/// 若将来需要兼岗, 把 role 改成逗号分隔并调整 rbac.hasRole 即可,
/// 所有 route handler 不受影响 (它们只调 requireRole)。
model User {
  id           Int      @id @default(autoincrement())
  /// 登录名, 英文/数字
  username     String   @unique
  /// bcrypt hash, cost 10
  passwordHash String
  /// 中文姓名, 列表与归属展示用
  displayName  String
  /// admin 管理员 | sales 销售 | production 生产 | finance 财务 | resource 资源管理员
  role         String
  /// 停用后无法登录。已签发的 JWT 需等过期才失效, 但所有写操作会用
  /// requireRoleFresh 复查本字段, 所以停用后立即写不了数据。
  active       Boolean  @default(true)
  note         String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedProjects     Project[]         @relation("ProjectOwner")
  ownedDesks        Desk[]            @relation("DeskOwner")
  ownedSuppliers    Supplier[]        @relation("SupplierOwner")
  purchases         Purchase[]
  reportedRequests  ResourceRequest[] @relation("RequestReporter")
  handledRequests   ResourceRequest[] @relation("RequestHandler")
  productionBatches ProductionBatch[]

  @@index([role])
}

// ═══════════════════════════════════════════════════════════════════
// 项目 —— 一切成本与收入的归集维度
//   "做的事情分成一个个项目, 每个项目独立但逻辑一样, 只是匹配不同的
//    销售产品。台子、采购在计算成本时都归属到项目里。"
//   本表只负责"立项", 不含任何统计字段 —— 收入/成本/利润全部由
//   src/lib/profit.ts 实时聚合, 避免冗余字段与真实流水不一致。
// ═══════════════════════════════════════════════════════════════════

model Project {
  id          Int      @id @default(autoincrement())
  /// 项目代号, 短标识, 用于列表与筛选 (如 "P-2026-01")
  code        String   @unique
  name        String
  /// active 进行中 | paused 暂停 | closed 已结束
  status      String   @default("active")
  /// 项目负责人 (通常是销售或管理员)
  ownerId     Int?
  description String   @default("")
  startedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User?             @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  products  Product[]
  desks     Desk[]
  suppliers Supplier[]
  purchases Purchase[]
  requests  ResourceRequest[]
  batches   ProductionBatch[]
  cards     CardResource[]
  proxies   ProxyResource[]
  emails    EmailResource[]

  @@index([status])
  @@index([ownerId])
}

// ═══════════════════════════════════════════════════════════════════
// 产品 —— 卡片视图, 销售可见
// ═══════════════════════════════════════════════════════════════════

/// status 与 capacity 按需求明确是【自由文本】而非枚举/数字。
/// 不要给它们加约束; 前端空值渲染成 "-", 状态色由关键词推导
/// (src/lib/product-status.ts), 推导不出就回落中性灰。
model Product {
  id        Int      @id @default(autoincrement())
  name      String
  /// 当前状态 —— 自由文本 (如 "稳定供货" / "缺货中" / "测试阶段")
  status    String?
  /// 产能 —— 自由文本, 可空 (如 "日均 200 个" / "看上游")
  capacity  String?
  /// 归属项目; 为空表示通用产品, 不绑定任何项目
  projectId Int?
  notes     String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project       Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  deskItems     DeskItem[]
  supplierItems SupplierItem[]
  batches       ProductionBatch[]

  @@index([projectId])
  @@index([sortOrder])
}

// ═══════════════════════════════════════════════════════════════════
// 台子 (下游客户/买家) —— 收入侧
//   台子本身记客户信息与需求描述; 具体卖什么、多少钱在 DeskItem 明细行。
//   一个台子可以有多条货明细 (不同产品不同单价)。
// ═══════════════════════════════════════════════════════════════════

model Desk {
  id        Int      @id @default(autoincrement())
  /// 台子名称 / 客户代号
  name      String
  /// 归属销售 —— 销售角色只能看到 ownerId = 自己的台子
  ownerId   Int
  projectId Int
  /// 联系方式 (TG / 微信 / 邮箱, 自由文本)
  contact   String   @default("")
  /// 货的需求情况 —— 自由文本, 多行。结构化的量价在 items 里
  demand    String   @default("")
  /// active 合作中 | paused 暂停 | closed 已终止
  status    String   @default("active")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User       @relation("DeskOwner", fields: [ownerId], references: [id])
  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   DeskItem[]

  @@index([ownerId])
  @@index([projectId])
  @@index([status])
}

/// 台子的一条货明细 = 产品 + 数量 + 卖价单价。
/// 行小计 quantity * unitPrice 不落库 —— 落库会与单价改动不一致。
/// unitPrice 是脱敏字段: 生产角色看不到卖价 (见 src/lib/mask.ts)。
model DeskItem {
  id        Int      @id @default(autoincrement())
  deskId    Int
  productId Int
  quantity  Float    @default(0)
  /// 卖价 (单价)
  unitPrice Float    @default(0)
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  desk    Desk    @relation(fields: [deskId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([deskId])
  @@index([productId])
}

// ═══════════════════════════════════════════════════════════════════
// 供货方 (上游供应商) —— 成本侧, 与台子结构对称但语义相反
//   刻意不与 Desk 合并成多态 Counterparty:
//   (a) 卖价/进价在利润聚合里是加号和减号, 合表后每个聚合都要
//       where kind, 漏一次就算错利润;
//   (b) 可见角色完全相反 (销售看台子, 资源/财务看供货方), 分表后
//       直接靠页面级 403 拦掉, 不用靠脱敏。
// ═══════════════════════════════════════════════════════════════════

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  /// 对接人 (资源管理员或采购)
  ownerId   Int?
  projectId Int
  contact   String   @default("")
  /// 供货渠道说明 —— 自由文本
  channel   String   @default("")
  /// active 合作中 | paused 暂停 | closed 已终止
  status    String   @default("active")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User?          @relation("SupplierOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   SupplierItem[]

  @@index([projectId])
  @@index([ownerId])
  @@index([status])
}

/// 供货方能提供的一种货 + 进货价。
/// quantity 语义是【已进货数量】, 默认 0 = "仅报价, 尚未进货"。
/// 项目成本聚合只累加 quantity > 0 的行 —— 报价不是成本, 否则录一个
/// 供应商报价利润就凭空掉一截。
/// unitPrice 是脱敏字段: 销售角色看不到进价。
model SupplierItem {
  id         Int      @id @default(autoincrement())
  supplierId Int
  productId  Int
  /// 已进货数量; 0 = 仅报价
  quantity   Float    @default(0)
  /// 进货价 (单价)
  unitPrice  Float    @default(0)
  note       String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([supplierId])
  @@index([productId])
}

// ═══════════════════════════════════════════════════════════════════
// 资源域 —— 来源 / 卡 / 代理IP / 邮箱
//   三类资源刻意用三张独立表而非一张多态表: 字段几乎不重叠 (合表只能
//   塞 JSON blob, 无法索引也无法做类型约束), 脱敏字段各不相同, 筛选
//   维度也完全不同。共性通过统一的字段命名约定复用而非共享表:
//     sourceId / status / projectId / notes / createdAt
//   status 通用取值: available 可用 | in_use 使用中 | used 已用完 | invalid 失效
// ═══════════════════════════════════════════════════════════════════

/// 资源来源 —— "这些邮箱/卡/IP 来自于谁的哪个渠道, 以及价格情况"。
/// 三类单价拆成独立字段而非只有自由文本: 消耗申报和采购要引用它做默认值。
model ResourceSource {
  id         Int      @id @default(autoincrement())
  /// 供应者名字 / 商家名
  name       String
  /// 渠道说明 (TG 群 / 网站 / 中间人, 自由文本)
  channel    String   @default("")
  /// 适用资源类型, 逗号分隔的 email/proxy/card; 空 = 通用
  kinds      String   @default("")
  contact    String   @default("")
  /// 各类资源的参考单价, 0 = 未报价。脱敏字段 (生产角色不可见)
  emailPrice Float    @default(0)
  proxyPrice Float    @default(0)
  cardPrice  Float    @default(0)
  /// 价格情况补充说明 —— 自由文本, 多行。脱敏字段
  priceInfo  String   @default("")
  active     Boolean  @default(true)
  notes      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cards        CardResource[]
  proxies      ProxyResource[]
  emails       EmailResource[]
  purchases    Purchase[]
  requestItems ResourceRequestItem[]

  @@index([active])
}

/// 卡资源。cardNo / cvv 是最高敏感级字段, 仅 resource + admin 可见。
model CardResource {
  id        Int       @id @default(autoincrement())
  sourceId  Int?
  /// 卡号 —— 脱敏字段
  cardNo    String
  /// 安全码 —— 脱敏字段
  cvv       String    @default("")
  /// 有效期, 存 "MM/YY" 文本而非 DateTime —— 卡面就是这个格式
  expiry    String    @default("")
  holder    String    @default("")
  /// 卡面金额 / 额度 —— 脱敏字段 (生产不可见)
  amount    Float     @default(0)
  /// 适用于什么业务 —— 自由文本
  usage     String    @default("")
  status    String    @default("available")
  projectId Int?
  notes     String    @default("")
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  source  ResourceSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  project Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([status])
  @@index([projectId])
}

/// 代理 IP 资源。
///   protocol —— 网络类型: socks | http
///   ipType   —— IP 类型:   static 静态 | dynamic 动态
/// 两个维度【正交】: 动态 IP 同样分 http / socks, 只是出口 IP 会不断
/// 变化, 所以必须拆成两列而不是一个 "socks5-dynamic" 复合枚举。
model ProxyResource {
  id        Int       @id @default(autoincrement())
  sourceId  Int?
  /// socks | http
  protocol  String    @default("socks")
  /// static | dynamic
  ipType    String    @default("static")
  host      String
  port      Int
  username  String    @default("")
  /// 代理密码 —— 脱敏字段 (销售/财务不可见; 生产要用所以可见)
  password  String    @default("")
  /// 地区 / 出口国家, 自由文本
  region    String    @default("")
  /// 动态 IP 的换 IP 接口地址; 静态 IP 留空
  rotateUrl String    @default("")
  expiresAt DateTime?
  status    String    @default("available")
  projectId Int?
  notes     String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  source  ResourceSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  project Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([protocol, ipType])
  @@index([status])
}

/// 邮箱资源。providerKey 指向代码侧接码插件注册表的 key
/// (src/lib/mailproviders/registry.ts), 决定用哪个 API 拉收件箱。
model EmailResource {
  id           Int      @id @default(autoincrement())
  sourceId     Int?
  /// 邮箱类型 = 接码 provider key, 如 "mock" / "outlook"
  providerKey  String   @default("mock")
  address      String   @unique
  /// 邮箱密码 —— 脱敏字段 (销售/财务不可见)
  password     String   @default("")
  /// 辅助邮箱 / 恢复信息
  recoveryInfo String   @default("")
  status       String   @default("available")
  projectId    Int?
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  source  ResourceSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  project Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([providerKey])
  @@index([status])
}

/// 接码 provider 的运行时配置 (API 地址 / token 等)。
/// provider 的【实现】在代码里 (每个一个 .ts 文件 + 注册表), 这张表只
/// 存【凭证与开关】。所以加新类型 = 新增一个文件 + 在此表加一行配置,
/// 不需要改任何 handler, 也不需要改 schema。
model EmailProviderConfig {
  id          Int      @id @default(autoincrement())
  providerKey String   @unique
  label       String   @default("")
  enabled     Boolean  @default(true)
  /// JSON 对象: provider.configFields 声明的键值, 如 {"apiBase":"…","apiKey":"…"}
  configJson  String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════
// 消耗申报 → 采购 的流转
//   生产提申报单 (这一批用掉了 X 个某来源的邮箱 / Y 个 IP / Z 张卡),
//   资源管理员或财务确认后据此建采购记录并回写状态。
//   Purchase.requestId 可空 —— 允许不经申报的直接采购。
// ═══════════════════════════════════════════════════════════════════

model ResourceRequest {
  id          Int       @id @default(autoincrement())
  projectId   Int
  /// 申报人 (生产)
  reporterId  Int
  /// 消耗发生的业务日 "YYYY-MM-DD"
  periodDate  String
  /// pending 待处理 | approved 已确认 | purchased 已采购 | rejected 已驳回
  status      String    @default("pending")
  note        String    @default("")
  /// 处理人 (资源管理员/财务/管理员)
  handledById Int?
  handledAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter  User                  @relation("RequestReporter", fields: [reporterId], references: [id])
  handledBy User?                 @relation("RequestHandler", fields: [handledById], references: [id], onDelete: SetNull)
  items     ResourceRequestItem[]
  purchases Purchase[]

  @@index([projectId])
  @@index([reporterId])
  @@index([status])
  @@index([periodDate])
}

/// 申报明细行: 某来源的某类资源用了多少个 (卡还要记金额)。
/// 刻意【不外键到具体资源行】—— 需求描述的是"多少个什么来源的邮箱"
/// 这种按来源聚合的量, 不是逐条勾选, 所以 kind + sourceId + quantity
/// 就够, 也因此完全不需要多态外键。
model ResourceRequestItem {
  id        Int    @id @default(autoincrement())
  requestId Int
  /// email | proxy | card
  kind      String
  sourceId  Int?
  quantity  Int    @default(0)
  /// 本行消耗的总金额 (卡类必填, 其余可留 0) —— 脱敏字段
  amount    Float  @default(0)
  note      String @default("")

  request ResourceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  source  ResourceSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([kind])
}

/// 采购记录 —— 项目成本的主要来源。
/// 需求要求的字段: 类型 / 采购人 / 采购内容 / 花费详情 / 花费总金额 / 归属项目。
/// "花费详情"用自由文本而非明细子表: 需求只要求"详情"一个描述性字段,
/// 拆子表是过度设计; 参与计算的只有 totalAmount。
model Purchase {
  id           Int      @id @default(autoincrement())
  projectId    Int
  /// 由哪张申报单产生; 为空 = 直接采购
  requestId    Int?
  /// email | proxy | card | other
  kind         String
  purchaserId  Int
  sourceId     Int?
  /// 采购内容 —— 自由文本 (如 "outlook 邮箱 200 个")
  content      String
  /// 花费详情 —— 自由文本, 多行 —— 脱敏字段
  detail       String   @default("")
  quantity     Int      @default(0)
  /// 花费总金额 —— 脱敏字段, 项目成本聚合的唯一依据
  totalAmount  Float    @default(0)
  /// 采购发生日 "YYYY-MM-DD"
  purchaseDate String
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  request   ResourceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  purchaser User             @relation(fields: [purchaserId], references: [id])
  source    ResourceSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([requestId])
  @@index([kind])
  @@index([purchaseDate])
}

// ═══════════════════════════════════════════════════════════════════
// 产出批次 —— 仪表盘"生产情况"的数据源
//   没有这张表, 生产卡片只能显示"申报了几单", 对管理层无意义。
// ═══════════════════════════════════════════════════════════════════

model ProductionBatch {
  id         Int      @id @default(autoincrement())
  projectId  Int
  productId  Int
  quantity   Float    @default(0)
  /// 生产日 "YYYY-MM-DD"
  batchDate  String
  /// 生产人
  operatorId Int
  note       String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product  Product @relation(fields: [productId], references: [id])
  operator User    @relation(fields: [operatorId], references: [id])

  @@index([projectId])
  @@index([productId])
  @@index([batchDate])
  @@index([operatorId])
}
