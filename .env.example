# Local dev (npm run dev/start). Docker uses values from compose env.
DATABASE_URL="file:./dev.db"
JWT_SECRET="please-change-me-to-a-long-random-string"
INITIAL_ADMIN_PASSWORD="changeme"
APP_PORT=3181

